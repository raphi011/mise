package ui

import "github.com/raphi011/mise/internal/i18n"

// NavItem identifies the active main navigation entry.
type NavItem int

const (
	NavNone NavItem = iota
	NavRecipes
	NavPlan
	NavGroceries
	NavSettings
)

// Page describes the document around a page's content.
type Page struct {
	// Title is the already-translated page title.
	Title  string
	Active NavItem
	// Theme is "light", "dark", or empty for the system preference.
	Theme string
}

func fontFaces() string {
	return `@font-face{font-family:Inter;font-style:normal;font-weight:400 600;font-display:swap;src:url(` + Asset("fonts/inter-latin.woff2") + `) format("woff2")}` +
		`@font-face{font-family:"Bricolage Grotesque";font-style:normal;font-weight:500 700;font-display:swap;src:url(` + Asset("fonts/bricolage-grotesque-latin.woff2") + `) format("woff2")}`
}

templ Layout(p Page) {
	<!DOCTYPE html>
	<html
		lang={ i18n.Locale(ctx).String() }
		if p.Theme == "light" || p.Theme == "dark" {
			data-theme={ p.Theme }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ p.Title } · mise</title>
			<link rel="icon" href={ Asset("img/icon.svg") } type="image/svg+xml"/>
			<link rel="preload" href={ Asset("fonts/inter-latin.woff2") } as="font" type="font/woff2" crossorigin/>
			<style>@templ.Raw(fontFaces())</style>
			<link rel="stylesheet" href={ Asset("css/app.css") }/>
			<script type="module" src={ Asset("js/datastar.js") }></script>
		</head>
		<body>
			<div class="shell">
				@nav(p.Active)
				<main class="main" id="main">
					<div class="content">
						<header class="page-header">
							<h1 class="page-title">{ p.Title }</h1>
							@avatarLink()
						</header>
						{ children... }
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ nav(active NavItem) {
	<nav class="nav" aria-label={ i18n.T(ctx, "nav.main") }>
		<a class="nav__brand" href="/" aria-label="mise">
			@logo()
			<span class="nav__brand-name" aria-hidden="true">mise</span>
		</a>
		<div class="nav__links">
			@navLink("/recipes", i18n.T(ctx, "nav.recipes"), active == NavRecipes, iconRecipes())
			@navLink("/plan", i18n.T(ctx, "nav.plan"), active == NavPlan, iconPlan())
			@navLink("/groceries", i18n.T(ctx, "nav.groceries"), active == NavGroceries, iconGroceries())
		</div>
		<div class="nav__footer">
			@avatarLink()
			<a href="/settings">{ i18n.T(ctx, "nav.settings") }</a>
		</div>
	</nav>
}

templ navLink(href, label string, active bool, icon templ.Component) {
	<a
		class="nav__link"
		href={ templ.SafeURL(href) }
		if active {
			aria-current="page"
		}
	>
		<span class="nav__icon">
			@icon
		</span>
		{ label }
	</a>
}

// avatarLink opens Settings. It shows a person icon until accounts exist.
templ avatarLink() {
	<a class="avatar" href="/settings" aria-label={ i18n.T(ctx, "nav.settings") }>
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5"></path></svg>
	</a>
}

templ logo() {
	<svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="10" fill="#2E6A43"></rect><path d="M5.5 16h6.5a3.25 3.25 0 0 1-6.5 0zM12.75 16h6.5a3.25 3.25 0 0 1-6.5 0zM20 16h6.5a3.25 3.25 0 0 1-6.5 0z" fill="#FFFFFF"></path><circle cx="16" cy="11.5" r="1.8" fill="#E3B86E"></circle></svg>
}

templ iconRecipes() {
	<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"></path><path d="M5 17a3 3 0 0 1 3-3h11"></path></svg>
}

templ iconPlan() {
	<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path></svg>
}

templ iconGroceries() {
	<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 6h10M10 12h10M10 18h10"></path><path d="M3.5 6l1.5 1.5L7.5 5M3.5 12l1.5 1.5 2.5-2.5M3.5 18l1.5 1.5 2.5-2.5"></path></svg>
}
