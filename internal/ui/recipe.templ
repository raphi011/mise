package ui

import "github.com/raphi011/mise/internal/i18n"

// RecipePage is a recipe's detail page. Its region re-renders over the
// live stream at the viewer's servings ($servings); the stepper changes
// the signal, which reopens the stream.
templ RecipePage(p Page, v RecipeView) {
	@Layout(p) {
		<div class="recipe" data-signals={ "{servings: " + itoa(v.Servings) + "}" } data-effect={ recipeLive(v.ID) }>
			@RecipeRegion(v)
			<div class="recipe-cta only-phone">
				@AddToPlanButton(v.ID, "btn--block")
			</div>
			if v.Toast != nil {
				@ToastRegion(*v.Toast)
			} else {
				@EmptyToast()
			}
			@EmptySheet()
		</div>
	}
}

// RecipeActions are the detail page's header buttons.
templ RecipeActions(v RecipeView) {
	@AddToPlanButton(v.ID, "btn--small only-wide")
	@RecipeFavourite(v)
	<a class="btn btn--secondary btn--small only-wide" href={ templ.SafeURL("/recipes/" + v.ID + "/edit") }>
		@iconEdit()
		{ i18n.T(ctx, "recipes.edit") }
	</a>
	<a
		class="icon-btn icon-btn--outline"
		href={ templ.SafeURL("/recipes/" + v.ID + "/menu") }
		data-on:click__prevent={ getAction("/recipes/" + v.ID + "/menu") }
		aria-label={ i18n.T(ctx, "recipes.menu.open") }
	>
		@iconMore()
	</a>
}

// RecipeFavourite is the favourite toggle, patched on its own.
templ RecipeFavourite(v RecipeView) {
	<form id="recipe-fav" class="inline-form" method="post" action={ templ.SafeURL("/recipes/" + v.ID + "/favourite") } data-on:submit={ postForm("/recipes/" + v.ID + "/favourite") }>
		<input type="hidden" name="on" value={ boolValue(!v.Favourite) }/>
		<button
			type="submit"
			class="icon-btn icon-btn--outline icon-btn--fav"
			aria-label={ i18n.T(ctx, "recipes.favourite") }
			aria-pressed={ boolValue(v.Favourite) }
		>
			@iconHeart(v.Favourite, 20, "")
		</button>
	</form>
}

// RecipeRegion is the live part of the detail page.
templ RecipeRegion(v RecipeView) {
	<div id="recipe-live" class="recipe__live">
		if v.Gone {
			<section class="empty" role="status">
				<h2>{ i18n.T(ctx, "recipes.gone.title") }</h2>
				<p>{ i18n.T(ctx, "recipes.gone.body") }</p>
				<p><a href="/recipes">{ i18n.T(ctx, "recipes.gone.link") }</a></p>
			</section>
		} else {
			<div class="recipe-hero">
				<div class={ "recipe-hero__media avatar--" + Tint(v.ID) }>
					if v.Photo != "" {
						<img src={ ImageURL(v.Photo, "full") } alt=""/>
					} else {
						<span class="recipe-hero__initial" aria-hidden="true">{ Initial(v.Name) }</span>
					}
				</div>
				<div class="recipe-hero__text">
					if len(v.Tags) > 0 {
						<ul class="recipe-tags" aria-label={ i18n.T(ctx, "recipes.tags") }>
							for _, t := range v.Tags {
								<li class="chip chip--static">{ t }</li>
							}
						</ul>
					}
					if v.Description != "" {
						<p class="recipe-hero__desc">{ v.Description }</p>
					}
					<p class="recipe-by">
						<span class={ avatarClass(v.By.Color, "xs") } aria-hidden="true">{ Initial(v.By.Name) }</span>
						<span>{ v.Attribution }</span>
					</p>
					<dl class="meta-tiles">
						if v.Prep != "" {
							@metaTile(i18n.T(ctx, "recipes.prep"), v.Prep, "")
						}
						if v.Cook != "" {
							@metaTile(i18n.T(ctx, "recipes.cook"), v.Cook, "")
						}
						@metaTile(i18n.T(ctx, "recipes.yield"), plural(ctx, v.Base, "recipes.servingsOne", "recipes.servings"), "only-wide")
						@metaTile(i18n.T(ctx, "recipes.cooked"), v.Cooked, "")
					</dl>
					if v.SourceURL != "" {
						<p class="recipe-source">
							<a href={ templ.SafeURL(v.SourceURL) } rel="noopener noreferrer" target="_blank">{ i18n.T(ctx, "recipes.source", v.SourceHost) }</a>
						</p>
					}
				</div>
			</div>
			<div class="recipe-body">
				<section class="recipe-section" id="ingredients" aria-labelledby="ingredients-title">
					<div class="recipe-section__head">
						<h2 class="recipe-section__title" id="ingredients-title">{ i18n.T(ctx, "recipes.ingredients") }</h2>
						@stepper(v)
					</div>
					if len(v.Ingredients) > 0 {
						<div class="recipe-status">
							<span role="status" aria-live="polite">{ v.ListStatus }</span>
							<a class="section-action" href={ templ.SafeURL("/groceries/lists/" + v.ListID) }>{ i18n.T(ctx, "recipes.openList") }</a>
						</div>
						<ul class="list ingredients" role="list">
							for _, ing := range v.Ingredients {
								@ingredientRow(v, ing)
							}
						</ul>
					} else {
						<p class="muted">{ i18n.T(ctx, "recipes.noIngredients") }</p>
					}
				</section>
				<section class="recipe-section" aria-labelledby="method-title">
					<div class="recipe-section__head">
						<h2 class="recipe-section__title" id="method-title">{ i18n.T(ctx, "recipes.method") }</h2>
						if len(v.Steps) > 0 {
							<a class="btn btn--strong btn--small" href={ templ.SafeURL(v.CookHref()) }>
								@iconPlay()
								{ i18n.T(ctx, "recipes.cookMode") }
							</a>
						}
					</div>
					if len(v.Steps) > 0 {
						<ol class="steps">
							for i, parts := range v.Steps {
								<li class="step">
									<span class="step__n" aria-hidden="true">{ itoa(i + 1) }</span>
									<p class="step__text">
										for _, part := range parts {
											if part.Mention {
												<span class="mention">
													{ part.Text }
													if part.Amount != "" {
														<span class="mention__amount">{ part.Amount }</span>
													}
												</span>
											} else {
												{ part.Text }
											}
										}
									</p>
								</li>
							}
						</ol>
						<p class="muted">{ i18n.T(ctx, "recipes.method.hint") }</p>
					} else {
						<p class="muted">{ i18n.T(ctx, "recipes.noSteps") }</p>
					}
				</section>
				<section class="recipe-section" aria-labelledby="notes-title">
					<div class="recipe-section__head">
						<h2 class="recipe-section__title" id="notes-title">{ i18n.T(ctx, "recipes.notes") }</h2>
						<a class="section-action" href={ templ.SafeURL("/recipes/" + v.ID + "/edit#notes") }>{ i18n.T(ctx, "recipes.notes.edit") }</a>
					</div>
					if v.Notes != "" {
						<div class="notes">
							<p class="notes__text">{ v.Notes }</p>
							if v.NotesBy != nil {
								<span class="notes__by">
									<span class={ avatarClass(v.NotesBy.Color, "xs") } aria-hidden="true">{ Initial(v.NotesBy.Name) }</span>
									{ i18n.T(ctx, "recipes.notes.by", v.NotesBy.Name, v.NotesWhen) }
								</span>
							}
						</div>
					} else {
						<p class="muted">{ i18n.T(ctx, "recipes.notes.none") }</p>
					}
				</section>
			</div>
		}
	</div>
}

templ metaTile(label, value, class string) {
	<div class={ "meta-tile", class }>
		<dt>{ label }</dt>
		<dd>{ value }</dd>
	</div>
}

// stepper changes the servings. Without JavaScript its buttons are links
// to the page at the other servings.
templ stepper(v RecipeView) {
	<div class="stepper" role="group" aria-label={ i18n.T(ctx, "recipes.servingsLabel") }>
		@stepperButton(v, v.Servings-1, v.Servings <= 1, "$servings = Math.max(1, $servings - 1)", i18n.T(ctx, "recipes.servingsLess"), "−")
		<span class="stepper__value">{ plural(ctx, v.Servings, "recipes.servingsOne", "recipes.servings") }</span>
		@stepperButton(v, v.Servings+1, v.Servings >= MaxServings, "$servings = Math.min("+itoa(MaxServings)+", $servings + 1)", i18n.T(ctx, "recipes.servingsMore"), "+")
	</div>
}

templ stepperButton(v RecipeView, n int, disabled bool, expr, label, sign string) {
	if disabled {
		<button type="button" class="stepper__btn" disabled aria-label={ label }>{ sign }</button>
	} else {
		<a class="stepper__btn" href={ templ.SafeURL(v.ServingsHref(n)) } aria-label={ label } data-on:click__prevent={ expr }>{ sign }</a>
	}
}

templ ingredientRow(v RecipeView, ing IngredientView) {
	<li class="ingredient">
		<span class="ingredient__name">
			{ ing.Name }
			if ing.Optional {
				<span class="ingredient__opt">{ i18n.T(ctx, "recipes.optional") }</span>
			}
		</span>
		if ing.Amount != "" {
			<span class="ingredient__amount">{ ing.Amount }</span>
		}
		<form method="post" action={ templ.SafeURL(toggleURL(v.ID, ing.ID)) } data-on:submit={ postForm(toggleURL(v.ID, ing.ID)) }>
			<input type="hidden" name="on" value={ boolValue(!ing.On) }/>
			<input type="hidden" name="servings" value={ itoa(v.Servings) }/>
			<button
				type="submit"
				class={ "list-toggle", templ.KV("list-toggle--on", ing.On) }
				aria-pressed={ boolValue(ing.On) }
				if ing.On {
					aria-label={ i18n.T(ctx, "recipes.takeOff", ing.Name, v.ListName) }
				} else {
					aria-label={ i18n.T(ctx, "recipes.putOn", ing.Name, v.ListName) }
				}
			>
				<span class="list-toggle__mark" aria-hidden="true">
					if ing.On {
						@iconCheck(16)
					} else {
						@iconPlus(16)
					}
				</span>
			</button>
		</form>
	</li>
}

// RecipeMenuSheet is the ⋯ menu as a bottom sheet / dialog.
templ RecipeMenuSheet(v RecipeMenuView) {
	<div id="sheet">
		<dialog id="recipe-menu" class="sheet-dialog" aria-labelledby="menu-title" data-init="el.open || el.showModal()" data-on:close="el.remove()">
			@recipeMenu(v, true)
		</dialog>
	</div>
}

// RecipeMenuPage is the ⋯ menu as a page, without JavaScript.
templ RecipeMenuPage(p Page, v RecipeMenuView) {
	@Layout(p) {
		<div class="narrow sheet">
			@recipeMenu(v, false)
		</div>
	}
}

templ recipeMenu(v RecipeMenuView, modal bool) {
	<div class="sheet__head">
		<span class="list__text">
			<h2 class="sheet__title" id="menu-title">{ v.Name }</h2>
			<span class="muted">{ i18n.T(ctx, "recipes.menu.shared", v.ByLabel) }</span>
		</span>
		if modal {
			<button type="button" class="icon-btn" aria-label={ i18n.T(ctx, "groceries.edit.close") } data-on:click="el.closest('dialog').close()">
				@iconClose()
			</button>
		}
	</div>
	<ul class="menu" role="list">
		<li>
			<a class="menu__item" href={ templ.SafeURL("/recipes/" + v.ID + "/edit") }>
				<span class="menu__icon">
					@iconEdit()
				</span>
				<span class="list__text">{ i18n.T(ctx, "recipes.menu.edit") }</span>
			</a>
		</li>
		<li>
			<form method="post" action={ templ.SafeURL("/recipes/" + v.ID + "/cooked") } data-on:submit={ postForm("/recipes/" + v.ID + "/cooked") }>
				<button type="submit" class="menu__item">
					<span class="menu__icon">
						@iconCheck(20)
					</span>
					<span class="list__text">
						<span>{ i18n.T(ctx, "plan.menu.cooked") }</span>
						<span class="muted">{ i18n.T(ctx, "recipes.menu.cookedNote") }</span>
					</span>
				</button>
			</form>
		</li>
		<li class="menu__share">
			<div class="menu__item menu__item--static">
				<span class="menu__icon">
					@iconLink()
				</span>
				<span class="list__text">
					<span>{ i18n.T(ctx, "recipes.menu.share") }</span>
					<span class="muted">{ i18n.T(ctx, "recipes.menu.shareNote") }</span>
				</span>
			</div>
			<div class="link-box">
				<label class="visually-hidden" for="share-url">{ i18n.T(ctx, "recipes.menu.share") }</label>
				<input class="link-box__input" id="share-url" type="text" readonly value={ v.ShareURL }/>
				<button
					type="button"
					class="btn btn--secondary btn--small"
					data-copy="share-url"
					data-copied={ i18n.T(ctx, "recipes.menu.copied") }
				>
					<span aria-live="polite">{ i18n.T(ctx, "recipes.menu.copy") }</span>
				</button>
			</div>
		</li>
	</ul>
	<a
		class="btn btn--destructive btn--block"
		href={ templ.SafeURL("/recipes/" + v.ID + "/delete") }
		data-on:click__prevent={ getAction("/recipes/" + v.ID + "/delete") }
	>
		@iconTrash()
		{ i18n.T(ctx, "recipes.menu.delete") }
	</a>
	if !modal {
		<a class="btn btn--secondary btn--block" href={ templ.SafeURL(RecipeHref(v.ID)) }>{ i18n.T(ctx, "recipes.menu.cancel") }</a>
	}
}

// DeleteRecipeDialog asks before deleting a recipe, as a modal dialog.
templ DeleteRecipeDialog(v DeleteRecipeView) {
	<div id="sheet">
		<dialog id="recipe-delete" class="confirm-dialog" role="alertdialog" aria-labelledby="delete-title" aria-describedby="delete-body" data-init="el.open || el.showModal()" data-on:close="el.remove()">
			@deleteRecipeBody(v, true)
		</dialog>
	</div>
}

// DeleteRecipePage asks before deleting a recipe, as a page.
templ DeleteRecipePage(p Page, v DeleteRecipeView) {
	@Layout(p) {
		<div class="narrow sheet">
			@deleteRecipeBody(v, false)
		</div>
	}
}

templ deleteRecipeBody(v DeleteRecipeView, modal bool) {
	<span class="confirm-dialog__icon confirm-dialog__icon--danger" aria-hidden="true">
		@iconTrash()
	</span>
	<h2 class="sheet__title" id="delete-title">{ i18n.T(ctx, "recipes.delete.title", v.Name) }</h2>
	<p class="confirm-dialog__body" id="delete-body">{ v.Body }</p>
	<div class="confirm-dialog__actions">
		<form method="post" action={ templ.SafeURL("/recipes/" + v.ID + "/delete") } data-on:submit={ postForm("/recipes/" + v.ID + "/delete") }>
			<button type="submit" class="btn btn--danger btn--block btn--tall">{ i18n.T(ctx, "recipes.delete.confirm") }</button>
		</form>
		if modal {
			<button type="button" class="btn btn--secondary btn--block btn--tall" data-on:click="el.closest('dialog').close()">{ i18n.T(ctx, "recipes.delete.keep") }</button>
		} else {
			<a class="btn btn--secondary btn--block btn--tall" href={ templ.SafeURL(RecipeHref(v.ID)) }>{ i18n.T(ctx, "recipes.delete.keep") }</a>
		}
	</div>
}

templ iconPlay() {
	<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
}
