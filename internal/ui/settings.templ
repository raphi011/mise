package ui

import "github.com/raphi011/mise/internal/i18n"

// SettingsView is the Settings overview. On phones it is a list with
// sub-pages; on wide screens the same sections become cards beside a
// section index.
type SettingsView struct {
	Name     string
	Username string
	Color    string
	Admin    bool
	Members  []MemberRow
	Invites  []InviteRow
	// Prefs holds the theme, language and units values and errors.
	Prefs     Form
	Themes    []Option
	Languages []Option
	Units     []Option
	// Notice is a translated status message after a change.
	Notice string
	// Lists are the household's shopping lists.
	Lists []ListTab
	// ListForm holds errors of a list form; ListFormID names the list it
	// belongs to ("" for the new-list form).
	ListForm   Form
	ListFormID string
	// UndoList is a list just deleted, offered for restoring.
	UndoList string
	// Categories counts the household's categories.
	Categories int
	// Tags counts the household's recipe tags.
	Tags int
	// AIStatus labels the AI connection (off, not tested, connected, failed)
	// and AIStatusClass styles it. Shown to admins only.
	AIStatus      i18n.Key
	AIStatusClass string
}

// MemberRow is one person in the People list.
type MemberRow struct {
	Name  string
	Color string
	// Role is the translated role.
	Role string
	You  bool
	// Href links to the member page (admins only).
	Href string
}

// InviteRow is a pending invite in the People list.
type InviteRow struct {
	ID    string
	Label string
	// Note says who invited and when it expires, translated.
	Note string
	Role string
}

templ Settings(p Page, v SettingsView) {
	@Layout(p) {
		if v.UndoList != "" {
			<div class="notice notice--undo" role="status" aria-live="polite">
				<span>{ v.Notice }</span>
				@postButton("/settings/lists/"+v.UndoList+"/restore", i18n.T(ctx, "groceries.undo"), "btn-link", nil)
			</div>
		} else {
			@notice(v.Notice)
		}
				<a class="profile-card profile-card--link" href="/settings/account">
					@avatar(v.Name, v.Color, "md")
					<span class="profile-card__text">
						<span class="profile-card__name">{ v.Name }</span>
						<span class="muted">{ i18n.T(ctx, "settings.profileSubtitle", v.Username) }</span>
					</span>
					@chevron()
				</a>
				<section class="settings-section" id="people" aria-labelledby="people-title">
					<div class="settings-section__head">
						<span class="settings-section__titles">
							<h2 class="settings-section__title" id="people-title">{ i18n.T(ctx, "settings.people") }</h2>
							<span class="settings-section__desc">{ i18n.T(ctx, "settings.peopleNote") }</span>
						</span>
						if v.Admin {
							<a class="settings-section__action" href="/settings/invite">
								@iconPlus(14)
								{ i18n.T(ctx, "settings.invite") }
							</a>
						}
					</div>
					<ul class="list" role="list">
						for _, m := range v.Members {
							<li class="list__row">
								if m.Href != "" {
									<a class="list__link" href={ templ.SafeURL(m.Href) }>
										@memberRowBody(m)
										@chevron()
									</a>
								} else {
									<span class="list__link">
										@memberRowBody(m)
									</span>
								}
							</li>
						}
						for _, inv := range v.Invites {
							<li class="list__row">
								<span class="list__link">
									<span class="avatar avatar--sm avatar--pending" aria-hidden="true">?</span>
									<span class="list__text">
										<span>{ inv.Label }</span>
										<span class="list__note">{ inv.Note }</span>
									</span>
									<span class="role-label role-label--pending">{ i18n.T(ctx, "settings.pending") }</span>
								</span>
								@postButton("/settings/invites/"+inv.ID+"/revoke", i18n.T(ctx, "settings.revokeInvite"), "btn btn--ghost btn--small", nil)
							</li>
						}
					</ul>
					<span class="settings-section__foot">{ i18n.T(ctx, "settings.peopleNote") }</span>
				</section>
				@listsSection(v)
				<section class="settings-section" id="library" aria-labelledby="library-title">
					<div class="settings-section__head">
						<span class="settings-section__titles">
							<h2 class="settings-section__title" id="library-title">{ i18n.T(ctx, "settings.groceriesRecipes") }</h2>
							<span class="settings-section__desc">{ i18n.T(ctx, "settings.groceriesRecipesNote") }</span>
						</span>
					</div>
					<ul class="list" role="list">
						<li class="list__row">
							<a class="list__link" href="/settings/categories">
								<span class="list__text">{ i18n.T(ctx, "settings.categories") }</span>
								<span class="role-label">{ itoa(v.Categories) }</span>
								@chevron()
							</a>
						</li>
						<li class="list__row">
							<a class="list__link" href="/settings/tags">
								<span class="list__text">{ i18n.T(ctx, "settings.tags") }</span>
								<span class="role-label">{ itoa(v.Tags) }</span>
								@chevron()
							</a>
						</li>
						if v.Admin {
							<li class="list__row">
								<a class="list__link" href="/settings/ai">
									<span class="list__text">{ i18n.T(ctx, "settings.ai") }</span>
									<span class={ "conn-status", v.AIStatusClass }>{ i18n.T(ctx, v.AIStatus) }</span>
									@chevron()
								</a>
							</li>
						}
					</ul>
				</section>
				<section class="settings-section" id="app" aria-labelledby="app-title">
					<div class="settings-section__head">
						<h2 class="settings-section__title" id="app-title">{ i18n.T(ctx, "settings.app") }</h2>
					</div>
					<form class="list list--form" method="post" action="/settings/preferences">
						<div class="list__row list__row--field">
							<span class="list__label" id="pref-theme">{ i18n.T(ctx, "settings.theme") }</span>
							<div class="segmented" role="radiogroup" aria-labelledby="pref-theme">
								for _, o := range v.Themes {
									<label class="segmented__option">
										<input type="radio" name="theme" value={ o.Value } checked?={ v.Prefs.Value("theme") == o.Value }/>
										<span>{ o.Label }</span>
									</label>
								}
							</div>
						</div>
						<div class="list__row list__row--field">
							<label class="list__label" for="pref-language">{ i18n.T(ctx, "settings.language") }</label>
							<select class="input input--compact" id="pref-language" name="language">
								for _, o := range v.Languages {
									<option value={ o.Value } selected?={ v.Prefs.Value("language") == o.Value }>{ o.Label }</option>
								}
							</select>
						</div>
						<div class="list__row list__row--field">
							<span class="list__label" id="pref-units">{ i18n.T(ctx, "settings.units") }</span>
							<div class="segmented" role="radiogroup" aria-labelledby="pref-units">
								for _, o := range v.Units {
									<label class="segmented__option">
										<input type="radio" name="units" value={ o.Value } checked?={ v.Prefs.Value("units") == o.Value }/>
										<span>{ o.Label }</span>
									</label>
								}
							</div>
						</div>
						<div class="list__row list__row--actions">
							<span class="list__note">{ i18n.T(ctx, "settings.prefsNote") }</span>
							<button class="btn btn--primary btn--small" type="submit">{ i18n.T(ctx, "form.save") }</button>
						</div>
					</form>
				</section>
				<div class="settings-signout">
					@postButton("/signout", i18n.T(ctx, "settings.signOut"), "btn btn--destructive", nil)
				</div>
	}
}

templ memberRowBody(m MemberRow) {
	@avatar(m.Name, m.Color, "sm")
	<span class="list__text">
		if m.You {
			{ i18n.T(ctx, "settings.you", m.Name) }
		} else {
			{ m.Name }
		}
	</span>
	<span class="role-label">{ m.Role }</span>
}

templ iconPeople() {
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7" r="4"></circle><path d="M2 21a7 7 0 0 1 14 0M16 3.5a4 4 0 0 1 0 7M18 14a6 6 0 0 1 4 6"></path></svg>
}

templ iconSliders() {
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8M16 5v4M10 15v4"></path></svg>
}

templ iconUser() {
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
}

// AccountView is the account page.
type AccountView struct {
	Name     string
	Username string
	// Email is the stored address; changing it takes the current password.
	Email string
	// HasPassword is false for an account that signs in only with SSO: it
	// cannot change its email address or password, so the page asks for no
	// password and offers no password change.
	HasPassword bool
	Color       string
	Colors      []Option
	Profile     Form
	Password    Form
	// PasswordOpen expands the change-password form, e.g. after an error.
	PasswordOpen bool
	Sessions     []SessionRow
	Notice       string
	// SSO is the single sign-on link; nil when SSO is not configured.
	SSO *SSOLink
}

// SSOLink is whether the account is linked to the SSO provider.
type SSOLink struct {
	Name   string
	Linked bool
	// CanLink offers linking: the base URL for the provider's callback is
	// known.
	CanLink bool
}

// SessionRow is one signed-in device.
type SessionRow struct {
	ID string
	// Device is a translated description of the user agent.
	Device   string
	LastSeen string
	Current  bool
}

templ Account(p Page, v AccountView) {
	@Layout(p) {
		@notice(v.Notice)
		<div class="stack-lg">
			<form class="stack-lg" method="post" action="/settings/account/profile" novalidate>
				@formAlert(v.Profile)
				<div class="account-hero">
					@avatar(v.Name, v.Color, "lg")
					<span class="muted">{ "@" + v.Username }</span>
				</div>
				<fieldset class="swatches">
					<legend class="field__label">{ i18n.T(ctx, "account.color") }</legend>
					<div class="swatches__options">
						for _, c := range v.Colors {
							<label class={ "swatch avatar--" + c.Value }>
								<input type="radio" name="avatar_color" value={ c.Value } checked?={ v.Profile.Value("avatar_color") == c.Value }/>
								<span class="visually-hidden">{ c.Label }</span>
							</label>
						}
					</div>
					@fieldError("avatar-color-error", v.Profile.Error("avatar_color"))
				</fieldset>
				<div class="card stack">
					@textField(Field{ID: "account-name", Name: "name", Label: i18n.T(ctx, "field.name"), Autocomplete: "name", Required: true}, v.Profile)
					@textField(Field{ID: "account-email", Name: "email", Label: i18n.T(ctx, "field.email"), Type: "email", Autocomplete: "email", LabelNote: i18n.T(ctx, "field.emailNote"),
						Attrs: templ.Attributes{"data-bind:_newemail": true}}, v.Profile)
					// Without JavaScript the password field is always there; with it, only
					// once the address differs from the stored one.
					if v.HasPassword {
						<div data-signals={ "{_oldemail: " + jsString(v.Email) + "}" } data-show="$_newemail.trim().toLowerCase() !== $_oldemail.toLowerCase()">
							@textField(Field{ID: "account-email-password", Name: "current_password", Label: i18n.T(ctx, "field.currentPassword"), Type: "password", Autocomplete: "current-password",
								Hint: i18n.T(ctx, "account.emailPasswordHint")}, v.Profile)
						</div>
					}
					<span class="field__hint">{ i18n.T(ctx, "account.visibleNote") }</span>
					<div>
						<button class="btn btn--primary" type="submit">{ i18n.T(ctx, "form.save") }</button>
					</div>
				</div>
			</form>
			<section class="settings-section settings-section--plain" aria-labelledby="security-title">
				<div class="settings-section__head">
					<h2 class="settings-section__title" id="security-title">{ i18n.T(ctx, "account.security") }</h2>
				</div>
				<div class="list">
					if v.HasPassword {
						<details class="disclosure" open?={ v.PasswordOpen }>
							<summary class="list__link">
								<span class="list__text">{ i18n.T(ctx, "account.changePassword") }</span>
								@chevron()
							</summary>
							<form class="stack disclosure__body" method="post" action="/settings/account/password" novalidate>
								@formAlert(v.Password)
								@textField(Field{ID: "account-current-password", Name: "current_password", Label: i18n.T(ctx, "field.currentPassword"), Type: "password", Autocomplete: "current-password", Required: true}, v.Password)
								@textField(Field{ID: "account-new-password", Name: "new_password", Label: i18n.T(ctx, "field.newPassword"), Type: "password", Autocomplete: "new-password", Required: true, Hint: i18n.T(ctx, "field.passwordHint")}, v.Password)
								<span class="field__hint">{ i18n.T(ctx, "account.passwordOthersSignedOut") }</span>
								<div>
									<button class="btn btn--primary" type="submit">{ i18n.T(ctx, "account.changePassword") }</button>
								</div>
							</form>
						</details>
					} else {
						<div class="list__row">
							<span class="list__link">
								<span class="list__text">
									<span>{ i18n.T(ctx, "account.changePassword") }</span>
									<span class="muted">{ i18n.T(ctx, "account.noPassword") }</span>
								</span>
							</span>
						</div>
					}
					<a class="list__link" href="/settings/account/tokens">
						<span class="list__text">
							<span>{ i18n.T(ctx, "account.tokens") }</span>
							<span class="muted">{ i18n.T(ctx, "account.tokensNote") }</span>
						</span>
						@chevron()
					</a>
					if v.SSO != nil {
						<div class="list__row">
							<span class="list__link">
								<span class="list__text">
									<span>{ i18n.T(ctx, "account.sso.title", v.SSO.Name) }</span>
									<span class="muted">
										if v.SSO.Linked {
											{ i18n.T(ctx, "account.sso.linked") }
										} else {
											{ i18n.T(ctx, "account.sso.notLinked") }
										}
									</span>
								</span>
							</span>
							if v.SSO.Linked {
								@postButton("/settings/account/sso/unlink", i18n.T(ctx, "account.sso.unlink"), "btn btn--ghost btn--small", nil)
							} else if v.SSO.CanLink {
								@postButton("/settings/account/sso/link", i18n.T(ctx, "account.sso.link"), "btn btn--secondary btn--small", nil)
							}
						</div>
					}
				</div>
			</section>
			<section class="settings-section settings-section--plain" aria-labelledby="devices-title">
				<div class="settings-section__head">
					<h2 class="settings-section__title" id="devices-title">{ i18n.T(ctx, "account.devices") }</h2>
					if len(v.Sessions) > 1 {
						@postButton("/settings/account/sessions/revoke-others", i18n.T(ctx, "account.signOutOthers"), "settings-section__action btn-link", nil)
					}
				</div>
				<ul class="list" role="list">
					for _, sess := range v.Sessions {
						<li class="list__row">
							<span class="list__link">
								<span class="list__text">
									<span>{ sess.Device }</span>
									<span class="muted">
										if sess.Current {
											{ i18n.T(ctx, "account.thisDevice") }
										} else {
											{ i18n.T(ctx, "account.lastSeen", sess.LastSeen) }
										}
									</span>
								</span>
							</span>
							if !sess.Current {
								@postButton("/settings/account/sessions/"+sess.ID+"/revoke", i18n.T(ctx, "account.revoke"), "btn btn--ghost btn--small", nil)
							}
						</li>
					}
				</ul>
			</section>
			<div class="stack">
				@postButton("/signout", i18n.T(ctx, "settings.signOut"), "btn btn--destructive btn--block", nil)
				<p class="fine-print">{ i18n.T(ctx, "account.deleteNote") }</p>
			</div>
		</div>
	}
}

// InvitePageView is the invite sheet: the form, or the created link.
type InvitePageView struct {
	Form  Form
	Roles []Option
	// Link is the invite URL just created, shown once.
	Link string
	// CanEmail is set when SMTP is configured: an invite with an address
	// is also emailed.
	CanEmail bool
	// Mail is "sent" or "failed" after emailing the link just created.
	Mail string
}

templ InvitePage(p Page, v InvitePageView) {
	@Layout(p) {
		<div class="sheet">
			<p class="lead">{ i18n.T(ctx, "invite.lead") }</p>
			if v.Link != "" {
				<div class="stack" data-signals:copied="false">
					<label class="field__label" for="invite-link">{ i18n.T(ctx, "invite.link") }</label>
					<div class="link-box">
						<input class="link-box__input" id="invite-link" type="text" readonly value={ v.Link } aria-describedby="invite-link-hint"/>
						<button
							class="btn btn--secondary btn--small"
							type="button"
							data-on:click="const link = document.getElementById('invite-link'); navigator.clipboard.writeText(link.value).then(() => { $copied = true }, () => { link.focus(); link.select() })"
						>{ i18n.T(ctx, "invite.copy") }</button>
					</div>
					<span class="field__hint" id="invite-link-hint">{ i18n.T(ctx, "invite.linkHint") }</span>
					switch v.Mail {
						case "sent":
							<p class="callout" role="status">
								@iconMail()
								<span class="callout__body">{ i18n.T(ctx, "invite.mail.sent") }</span>
							</p>
						case "failed":
							<p class="alert" role="alert">{ i18n.T(ctx, "invite.mail.failed") }</p>
					}
					<p class="notice" role="status" aria-live="polite" data-copied={ i18n.T(ctx, "invite.copied") } data-text="$copied ? el.dataset.copied : ''"></p>
					<div class="settings-actions">
						<a class="btn btn--primary" href="/settings#people">{ i18n.T(ctx, "invite.done") }</a>
						<a class="btn btn--secondary" href="/settings/invite">{ i18n.T(ctx, "invite.another") }</a>
					</div>
				</div>
			} else {
				<form class="stack-lg" method="post" action="/settings/invites" novalidate>
					@formAlert(v.Form)
					@textField(Field{ID: "invite-email", Name: "email", Label: i18n.T(ctx, "field.email"), Type: "email", Autocomplete: "off",
						LabelNote: i18n.T(ctx, "field.optional"), Hint: inviteEmailHint(ctx, v.CanEmail), Attrs: templ.Attributes{"placeholder": "name@example.com"}}, v.Form)
					@roleChoice("invite-role", v.Roles, v.Form)
					<span class="field__hint">{ i18n.T(ctx, "invite.expiry") }</span>
					<div>
						<button class="btn btn--primary btn--block" type="submit">{ i18n.T(ctx, "invite.create") }</button>
					</div>
				</form>
			}
		</div>
	}
}

templ roleChoice(id string, roles []Option, form Form) {
	<fieldset class="choices" aria-describedby={ id + "-error" }>
		<legend class="field__label">{ i18n.T(ctx, "invite.joinAs") }</legend>
		for _, o := range roles {
			<label class="choice">
				<input type="radio" name="role" value={ o.Value } checked?={ form.Value("role") == o.Value }/>
				<span class="choice__text">
					<span class="choice__title">{ o.Label }</span>
					<span class="choice__hint">{ o.Hint }</span>
				</span>
			</label>
		}
		@fieldError(id+"-error", form.Error("role"))
	</fieldset>
}

// MemberPageView is an admin's view of one member.
type MemberPageView struct {
	ID       string
	Name     string
	Username string
	Color    string
	Joined   string
	You      bool
	Roles    []Option
	RoleForm Form
	Password Form
	Remove   Form
	Notice   string
}

templ MemberPage(p Page, v MemberPageView) {
	@Layout(p) {
		@notice(v.Notice)
		<div class="stack-lg">
			<div class="profile-card">
				@avatar(v.Name, v.Color, "md")
				<span class="profile-card__text">
					<span class="profile-card__name">{ v.Name }</span>
					<span class="muted">{ "@" + v.Username + " · " + v.Joined }</span>
				</span>
			</div>
			if v.You {
				<p class="callout">
					<span class="callout__body">
						<span>{ i18n.T(ctx, "member.isYou") }</span>
						<a href="/settings/account">{ i18n.T(ctx, "settings.accountAndSecurity") }</a>
					</span>
				</p>
			}
			<form class="card stack" method="post" action={ templ.SafeURL("/settings/people/" + v.ID + "/role") }>
				@formAlert(v.RoleForm)
				@roleChoice("member-role", v.Roles, v.RoleForm)
				<div>
					<button class="btn btn--primary" type="submit">{ i18n.T(ctx, "member.saveRole") }</button>
				</div>
			</form>
			if !v.You {
				<form class="card stack" method="post" action={ templ.SafeURL("/settings/people/" + v.ID + "/password") } novalidate>
					<h2 class="card__title">{ i18n.T(ctx, "member.resetPassword") }</h2>
					@formAlert(v.Password)
					@textField(Field{ID: "member-password", Name: "password", Label: i18n.T(ctx, "field.newPassword"), Type: "password", Autocomplete: "new-password", Required: true,
						Hint: i18n.T(ctx, "member.resetHint", v.Name)}, v.Password)
					<div>
						<button class="btn btn--secondary" type="submit">{ i18n.T(ctx, "member.setPassword") }</button>
					</div>
				</form>
				<details class="card disclosure disclosure--danger" open?={ v.Remove.HasErrors() }>
					<summary class="disclosure__summary">{ i18n.T(ctx, "member.remove") }</summary>
					<form class="stack disclosure__body" method="post" action={ templ.SafeURL("/settings/people/" + v.ID + "/remove") }>
						@formAlert(v.Remove)
						<p>{ i18n.T(ctx, "member.removeBody", v.Name) }</p>
						<input type="hidden" name="confirm" value="yes"/>
						<div>
							<button class="btn btn--destructive" type="submit">{ i18n.T(ctx, "member.removeConfirm", v.Name) }</button>
						</div>
					</form>
				</details>
			}
		</div>
	}
}

templ listsSection(v SettingsView) {
	<section class="settings-section" id="lists" aria-labelledby="lists-title">
		<div class="settings-section__head">
			<span class="settings-section__titles">
				<h2 class="settings-section__title" id="lists-title">{ i18n.T(ctx, "settings.lists") }</h2>
				<span class="settings-section__desc">{ i18n.T(ctx, "settings.listsNote") }</span>
			</span>
		</div>
		<ul class="list" role="list">
			for i, l := range v.Lists {
				<li class="list__row">
					<details class="disclosure" open?={ v.ListFormID == l.ID }>
						<summary class="list__link">
							<span class="list__text">{ l.Name }</span>
							<span class="role-label">
								if l.Open > 0 {
									{ i18n.T(ctx, "settings.listItems", l.Open) }
								} else {
									{ i18n.T(ctx, "settings.listEmpty") }
								}
							</span>
							@chevron()
						</summary>
						<div class="stack disclosure__body">
							<form class="stack" method="post" action={ templ.SafeURL("/settings/lists/" + l.ID + "/rename") } novalidate>
								if v.ListFormID == l.ID {
									@formAlert(v.ListForm)
								}
								<div class="inline-field">
									@textField(Field{ID: "list-name-" + l.ID, Name: "name", Label: i18n.T(ctx, "settings.listName"), Required: true}, listNameForm(v, l))
									<button class="btn btn--secondary" type="submit">{ i18n.T(ctx, "settings.rename") }</button>
								</div>
							</form>
							<div class="settings-list-actions">
								if i > 0 {
									@postButton("/settings/lists/"+l.ID+"/move", i18n.T(ctx, "settings.moveUp"), "btn btn--ghost btn--small", map[string]string{"to": itoa(i - 1)})
								}
								if i < len(v.Lists)-1 {
									@postButton("/settings/lists/"+l.ID+"/move", i18n.T(ctx, "settings.moveDown"), "btn btn--ghost btn--small", map[string]string{"to": itoa(i + 1)})
								}
								if len(v.Lists) > 1 {
									@postButton("/settings/lists/"+l.ID+"/delete", i18n.T(ctx, "settings.deleteList"), "btn btn--ghost btn--small btn--danger-text", nil)
								}
							</div>
						</div>
					</details>
				</li>
			}
			<li class="list__row list__row--form">
				<form class="new-list" method="post" action="/settings/lists" novalidate>
					if v.ListFormID == "" {
						@formAlert(v.ListForm)
					}
					<label class="visually-hidden" for="new-list-name">{ i18n.T(ctx, "settings.newList") }</label>
					<input
						class="input"
						id="new-list-name"
						name="name"
						type="text"
						required
						placeholder={ i18n.T(ctx, "settings.newList") }
						value={ newListForm(v).Value("name") }
						if newListForm(v).Error("name") != "" {
							aria-invalid="true"
							aria-describedby="new-list-name-error"
						}
					/>
					<button class="btn btn--secondary" type="submit">
						@iconPlus(16)
						{ i18n.T(ctx, "settings.createList") }
					</button>
					@fieldError("new-list-name-error", newListForm(v).Error("name"))
				</form>
			</li>
		</ul>
		<span class="settings-section__foot">{ i18n.T(ctx, "settings.listsFoot") }</span>
	</section>
}
